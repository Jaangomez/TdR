def increment(absft):
    amplituds = []
    step = 251
    x = 251
    while  step <= len(absft):
        maxim = (max(absft[(step-251):step]))
        index = np.where(absft==maxim)[0][0]
        amplituds.append (maxim)
        step += 250
        x += 250
    amplituds.sort()
    amplituds_màximes = amplituds[-10:len(amplituds)]
    dicc = {}
    for i in amplituds_màximes:
        indexs = searchindex (i, absft)
        dicc [i] = freq[indexs]
       
